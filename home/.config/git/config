[alias]
	br = branch
	bv = branch -vv
	bva = branch -vv --all
	ci = commit
	fix = ci --fixup
	co = checkout
	df = diff
	lgp = log -p
	gl = log --date=format:'%Y-%m-%d %T' --pretty=format:'%C(yellow)%h%Creset %C(dim)%ad%C(auto)%d%Creset %s %C(dim cyan)(%an: %cr)%Creset'
	glo = gl --graph --date-order
	gl1 = glo HEAD
	glm = glo --branches="*master" --branches="*main" --branches="*staging" HEAD
	gla = glo --all
	st = status --branch
	pf = push --force-with-lease
	rebiq = rebase --interactive --autosquash

[branch]
	sort = -committerdate

[color]
	ui = auto

[column]
	ui = auto

[commit]
	verbose = true

[core]
	excludesfile = ~/.config/git/ignore
	whitespace = trailing-space,space-before-tab
	ignorecase = false
	editor = /usr/bin/vim -i NONE -c \"set fenc=utf-8\"
	sshCommand = "ssh -i ${HOME}/.ssh/id_ed25519"

[credential]
	helper =
	helper = /usr/local/share/gcm-core/git-credential-manager

[diff]
	algorithm = histogram
	colorMoved = plain
	compactionHeuristic = true
	mnemonicPrefix = true
	renames = true
	orderFile = ~/.config/git/.order

[fetch]
	prune = true
	pruneTags = true
	all = true

[ghq]
	root = ~/projects

[init]
	defaultBranch = main

[pager]
	log = less
	show = less
	diff = less

[push]
	default = simple
	autoSetupRemote = true
	followTags = true

[rebase]
	autoSquash = true
	autoStash = true
	updateRefs = true

[rerere]
	enabled = true
	autoUpdate = true

[tag]
	sort = version:refname

[user]
	name = shkumagai
	email = "take.this.2.your.grave@gmail.com"

# Machine/work specific settings (e.g. includeIf for work repositories).
# Missing files are ignored by git.
[include]
	path = ~/.config/git-local/config

[credential "https://dev.azure.com"]
	useHttpPath = true
