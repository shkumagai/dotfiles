// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "cli_default_open_behavior": "new_window",
  "agent": {
    "dock": "left",
    "default_profile": "ask",
    "default_model": {
      "effort": "high",
      "provider": "copilot_chat",
      "model": "gpt-5.3-codex",
      "enable_thinking": false,
    },
    "favorite_models": [],
    "model_parameters": [],
  },
  "agent_buffer_font_size": 12.5,
  "agent_ui_font_size": 12.5,
  "collaboration_panel": {
    "dock": "right",
  },
  "git_panel": {
    "dock": "right",
  },
  "outline_panel": {
    "dock": "right",
  },
  "project_panel": {
    "dock": "right",
  },
  "minimap": {
    "show": "auto",
  },
  "ui_font_size": 16.0, // ディレクトリツリーとかの文字サイズ
  "ui_font_weight": 400,
  "buffer_font_size": 12.5, // エディタとかの文字サイズ
  "buffer_font_weight": 400.0,
  "buffer_font_family": "NotoSansM Nerd Font Mono",
  "buffer_font_fallbacks": ["NOTONOTO", "Noto Sans"],
  "session": {
    "trust_all_worktrees": true,
  },
  "edit_predictions": {
    "provider": "copilot",
  },
  "terminal": {
    "font_size": 12.5, // ターミナル内の文字サイズ
    "font_family": "NotoSansM Nerd Font Mono",
    "font_fallbacks": ["NOTONOTO", "Noto Sans"],
  },
  "file_types": {
    "terraform": ["*.tf"],
    "dockerfile": ["Dockerfile"],
    "Makefile": ["Makefile", "*.mk"],
  },
  "file_scan_exclusions": [
    "**/.git",
    "**/__pycache__",
  ],
  "show_whitespaces": "all",
  "base_keymap": "Emacs",
  "theme": {
    "mode": "dark",
    "light": "One Light",
    "dark": "Everforest Dark Medium (material)",
  },
  "languages": {
    "Python": {
      "indent_guides": {
        "coloring": "indent_aware",
        "background_coloring": "indent_aware",
      },
      "tab_size": 4,
      "formatter": "language_server",
      "format_on_save": "on",
      "language_servers": ["ty", "ruff", "!basedpyright"],
      "show_completions_on_input": true,
    },
    "JavaScript": {
      "tab_size": 2,
    },
  },
}
