#!/bin/bash

TEMP_PASSWD=/tmp/_passwd
# shellcheck disable=SC2034
WINDOW_NAME=$(basename "$0")

function get-passwds ()
{
  if [ ! -f ${TEMP_PASSWD} ]; then
    read -rsp "Enter password for account: " passwd; echo
    read -rsp "Enter passphrase for key: " passphrase; echo
    cat <<_EOT > $TEMP_PASSWD
passwd=${passwd}
passphrase=${passphrase}
_EOT
  else
    # shellcheck disable=SC1090
    source "${TEMP_PASSWD}"
  fi
}

function get-row-per-host ()
{
  num=${1}

  set -- "$(stty size)"
  rows=${1}
  cols=${2}
  echo -n $(((rows - "${num}") / "${num}"))
}

function get-cols-per-host ()
{
  num=${1}

  set -- "$(stty size)"
  rows=${1}
  cols=${2}
  echo -n $((cols / "${num}"))
}
