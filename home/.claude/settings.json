{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "attribution": {
    "commit": "🤖 Generated with Claude Code",
    "pr": "",
    "sessionUrl": false
  },
  "permissions": {
    "deny": [
      "Bash(sudo *)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git reset --hard *)",
      "Bash(git clean -f*)",
      "Bash(docker system prune*)",
      "Bash(wget *)",
      "Read(//**/.env)",
      "Read(//**/.env.*)",
      "Read(//**/*.pem)",
      "Read(//**/*id_rsa*)",
      "Read(//**/*id_ed25519*)",
      "Read(//**/*google_compute_engine*)",
      "Read(~/.config/gcloud/**)",
      "Read(~/.ssh/**)",
      "Edit(//**/.env)",
      "Edit(//**/secrets/**)"
    ],
    "ask": [
      "Bash(rm -rf *)"
    ],
    "defaultMode": "auto"
  },
  "model": "claude-sonnet-5",
  "language": "Japanese",
  "promptSuggestionEnabled": false,
  "awaySummaryEnabled": false,
  "skipWorkflowUsageWarning": true,
  "theme": "auto",
  "editorMode": "normal",
  "remoteControlAtStartup": true,
  "skipAutoPermissionPrompt": true
}
